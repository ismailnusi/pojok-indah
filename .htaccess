# =====================================================
#  WEBTES — .htaccess Production Aman + SSL Lancar (FIX 500)
#  Penyebab 500 kemarin: <DirectoryMatch> & <LocationMatch>
#  TIDAK boleh dipakai di .htaccess (hanya httpd.conf/vhost).
#  Versi ini 100% kompatibel .htaccess shared hosting.
# =====================================================

# --- 1. Dasar ---
ServerSignature Off
Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # PENTING: jika web di/subdirectory (mis. public_html/WEBTES),
    # biarkan RewriteBase mengikuti folder. Untuk domain root
    # (public_html langsung), baris ini tidak masalah.
    # Jika hosting error, comment baris RewriteBase di bawah:
    # RewriteBase /

    # --- 2. Force HTTPS (Production saja) ---
    # Lewati localhost agar XAMPP tetap jalan via http
    RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$ [NC]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

    # --- 3. Izinkan Let's Encrypt ACME challenge (HARUS di atas blokir) ---
    RewriteRule ^\.well-known/acme-challenge/ - [L]

    # --- 4. Blokir akses .git/.svn/.hg/.env ---
    RewriteRule ^(\.git|\.svn|\.hg)(/|$) - [F,L,NC]

    # --- 5. Blokir query-string serangan klasik ---
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\) [NC,OR]
    RewriteCond %{QUERY_STRING} (base64_(en|de)code|%3Cscript|<script) [NC,OR]
    RewriteCond %{QUERY_STRING} (GLOBALS|_REQUEST)= [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# --- 6. Proteksi file sensitif ---
<FilesMatch "^(config\.php|database\.sql|\.htaccess|\.htpasswd|\.env|php\.ini|composer\.(json|lock)|package(-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Blokir ekstensi backup/log/dump
<FilesMatch "\.(sql|bak|backup|old|orig|save|swp|log|dist|gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Catatan: blokir dotfile generik "^\." SENGAJA DIHAPUS.
# Itu yang ikut memblokir /.well-known/ sehingga renewal SSL gagal
# dan di sebagian hosting memicu 500.

# --- 7. Blokir eksekusi script yang di-upload (lapisan 1) ---
# Lapisan 2 ada di assets/img/produk/.htaccess
<FilesMatch "\.(phtml|phar|php\d+|cgi|pl|py|sh|asp|aspx|jsp|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- 8. Security Headers ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains" env=HTTPS
    Header always set Content-Security-Policy "upgrade-insecure-requests"
    Header unset X-Powered-By
</IfModule>

# --- 9. Batasi HTTP method ---
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST|OPTIONS)$ [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# --- 10. Kompresi ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- 11. Browser caching ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|webp|svg|css|js|woff2?)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
